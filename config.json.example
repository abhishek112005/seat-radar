{
  "google_oauth": {
    "client_id": "your-google-client-id.apps.googleusercontent.com",
    "client_secret": "your-google-client-secret",
    "redirect_uri": "http://127.0.0.1:8000/auth/google/callback"
  },
  "show_name": "Movie Title - Theater",
  "show_url": "https://in.bookmyshow.com/events/your-event-or-seat-layout-url",
  "preferred_sections": [
    "Gold",
    "Platinum",
    "Director Choice"
  ],
  "preferred_seats": [
    "Gold"
  ],
  "exact_seats": [
    "A2",
    "A3"
  ],
  "desired_ticket_count": 2,
  "check_interval_sec": 60,
  "stop_after_first_alert": false,
  "headless": true,
  "notify_methods": [
    "sms",
    "whatsapp",
    "call"
  ],
  "notify_on_initial_status": true,
  "notify_on_booking_open": true,
  "web_host": "127.0.0.1",
  "web_port": 8000,
  "notifiers": {
    "twilio": {
      "account_sid": "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "auth_token": "your_twilio_auth_token",
      "from_number": "+1234567890",
      "whatsapp_from_number": "whatsapp:+14155238886",
      "to_number": "+919876543210",
      "verify_service_sid": "VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    }
  }
}
